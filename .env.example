# Optional: docker compose up works without copying this file.
# These defaults are for local development with synthetic data only.
POSTGRES_DB=iemp
POSTGRES_USER=iemp
POSTGRES_PASSWORD=iemp-local-only

# Optional backend override. Empty uses the POSTGRES_* settings above via PG*.
# Inside Compose use postgres:5432, not localhost. URL-encode credentials.
# DATABASE_URL=postgresql://iemp:iemp-local-only@postgres:5432/iemp
DATABASE_URL=

# Public browser configuration, baked into the frontend image at build time.
# Rebuild the frontend after changes. Never put credentials in VITE_* values.
VITE_API_BASE_URL=/api

FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_PORT=1883

# Native gateway/simulator MQTT_HOST and MQTT_PORT live in their own examples.
# MQTT_PORT here changes the published host port; the broker still uses 1883.
