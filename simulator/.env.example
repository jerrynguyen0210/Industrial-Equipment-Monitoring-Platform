# send_batch.py reads exported environment variables; it does not load .env.
# Reserved for future MQTT device mode (not implemented).
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# Working API-only mode bypasses the real gateway; include /api in the URL.
API_BASE_URL=http://127.0.0.1:8000/api
GATEWAY_API_KEY=replace-with-provisioned-test-gateway-credential
# Use a dedicated test credential, never the real gateway's credential.
# Provision the same token for a registered gateway in backend GATEWAY_CREDENTIALS_JSON.
