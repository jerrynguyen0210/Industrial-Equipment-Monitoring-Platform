# Planned simulator settings; no runtime/env loader exists yet.
# Device mode publishes to the same development broker as the gateway.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# Reserved for a future API-only test mode, which bypasses the real gateway.
API_BASE_URL=http://127.0.0.1:8000/api
GATEWAY_API_KEY=replace-with-provisioned-test-gateway-credential
# Use a dedicated test credential, never the real gateway's credential.
