# Native Vite development/build: copy to .env. All VITE_* values are public.
# Include the API prefix. A trailing slash is optional.
VITE_API_BASE_URL=/api

# Vite development proxy only; never exposed as browser configuration.
# Change this if the backend uses a different published host port.
API_PROXY_TARGET=http://127.0.0.1:8000

# Compose builds read VITE_API_BASE_URL from the root .env, not this file.
# Restart Vite after changes; rebuild for production. Never add secrets here.
