# simulate.py and send_batch.py read exported variables; neither loads .env.
# Scenario options (seed/profile/IDs/timing) are explicit simulate.py CLI flags.
# MQTT device mode. Paths are relative to the shell's working directory.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=device-demo-001
MQTT_PASSWORD_FILE=secrets/mosquitto/device-demo-001.password

# Working API-only mode bypasses the real gateway; include /api in the URL.
API_BASE_URL=http://127.0.0.1:8000/api
GATEWAY_API_KEY=replace-with-provisioned-test-gateway-credential
# Use a dedicated test credential, never the real gateway's credential.
# Provision the same token for a registered gateway in backend GATEWAY_CREDENTIALS_JSON.
