# Copy to .env for local values. Pass it with --config; no automatic loading.
# File paths are relative to this file. Never commit provisioned credentials.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=gateway-demo-001
MQTT_PASSWORD_FILE=../secrets/mosquitto/gateway-demo-001.password
# Include /api; the implemented ingestion path is /v1/telemetry/batches.
API_BASE_URL=http://127.0.0.1:8000/api
GATEWAY_API_KEY=replace-with-provisioned-gateway-credential
QUEUE_DB_PATH=./queue.sqlite3

# Provision a unique token in backend GATEWAY_CREDENTIALS_JSON and send it as
# Authorization: Bearer <token>. This placeholder is not usable. Never use VITE_*.
# For a Pi, replace loopback with the broker/API host's reachable LAN address.
# MQTT intake is enabled; HTTP forwarding is not yet implemented.
