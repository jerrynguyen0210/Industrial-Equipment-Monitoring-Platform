# Native backend only: copy to .env and run Uvicorn with --env-file .env.
# This assumes a separate local PostgreSQL instance; Compose does not publish DB.
# Synthetic local credentials only. Match the database you provisioned.
# URL-encode special characters in the username/password.
DATABASE_URL=postgresql://iemp:iemp-local-only@127.0.0.1:5432/iemp

# Compose reads the root .env instead. Its database hostname is postgres.
# When DATABASE_URL is empty/unset, all five PG* settings are required instead.
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=iemp
# PGUSER=iemp
# PGPASSWORD=iemp-local-only
